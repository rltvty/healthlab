# Control Garmin's native shell directly; no host Java/monkeydo required.
set timeout 15
set helper [lindex $argv 0]
proc require {pattern} {
    expect {
        -re $pattern { return }
        timeout { puts stderr "Timed out waiting for simulator: $pattern"; exit 1 }
        eof { puts stderr "Simulator connection closed: $pattern"; exit 1 }
    }
}
# Retry while the native app initializes its transport.
set connected 0
for {set attempt 0} {$attempt < 15} {incr attempt} {
    spawn -noecho $helper
    expect {
        -re {:>} { set connected 1 }
        eof {}
        timeout {}
    }
    if {$connected} { break }
    catch {close}
    catch {wait}
    after 1000
}
if {!$connected} { puts stderr "Could not connect to the simulator"; exit 1 }
send -- "ciq\r"
require {shellConnected}
send -- "\[1\]openDevice fr970\r"
require {deviceStarted fr970}
send -- "\[2\]startApp 14f33c6f21834451a866e6f7db67a980\r"
require {appStarted}
puts "\nHealthLab Time is running in the Forerunner 970 simulator."
close
wait
